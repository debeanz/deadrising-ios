+// Dead Rising (iOS build on macOS): a fault prints the stack (on its own signal stack, so a stack
+// overflow is reported too) instead of ending the run silently with status 139.
+static void CrashHandler(int signal)
+{
+    void* frames[64];
+    const int count = backtrace(frames, 64);
+    char message[64];
+    const int length = snprintf(message, sizeof(message), "XenosRecomp: signal %d, stack:\n", signal);
+    write(2, message, length);
+    backtrace_symbols_fd(frames, count, 2);
+    _exit(128 + signal);
+}
+
+static void InstallCrashHandler()
+{
+    static char alternateStack[1 << 16];
+    stack_t stack{};
+    stack.ss_sp = alternateStack;
+    stack.ss_size = sizeof(alternateStack);
+    sigaltstack(&stack, nullptr);
+    struct sigaction action{};
+    action.sa_handler = CrashHandler;
+    action.sa_flags = SA_ONSTACK;
+    sigaction(SIGSEGV, &action, nullptr);
+    sigaction(SIGBUS, &action, nullptr);
+    sigaction(SIGILL, &action, nullptr);
+    sigaction(SIGABRT, &action, nullptr);
+}
+
+// Each item on worker threads with 64 MB stacks: macOS gives std::execution's (libdispatch) worker
+// threads 512 KB, and DXC's compiler needs more.
+template<class Items, class Function>
+static void ParallelForBigStack(Items& items, Function function)
+{
+    std::vector<typename Items::iterator> list;
+    for (auto it = items.begin(); it != items.end(); ++it)
+        list.push_back(it);
+    struct Shared
+    {
+        std::vector<typename Items::iterator>* list;
+        Function* function;
+        std::atomic<size_t> next{ 0 };
+    } shared{ &list, &function };
+    auto run = [](void* argument) -> void*
+    {
+        auto* s = static_cast<Shared*>(argument);
+        stack_t stack{};
+        static thread_local char alternateStack[1 << 16];
+        stack.ss_sp = alternateStack;
+        stack.ss_size = sizeof(alternateStack);
+        sigaltstack(&stack, nullptr);
+        for (size_t i; (i = s->next++) < s->list->size();)
+            (*s->function)(*(*s->list)[i]);
+        return nullptr;
+    };
+    // One thread unless XENOS_THREADS says otherwise: the macOS build of DXC crashed when shaders
+    // were compiled on several threads at once (iOS build, 2026-11-25).
+    const char* threadsSetting = getenv("XENOS_THREADS");
+    const unsigned threads = std::max(1u, std::min(threadsSetting ? unsigned(atoi(threadsSetting)) : 1u, 16u));
+    std::vector<pthread_t> handles(threads);
+    pthread_attr_t attributes;
+    pthread_attr_init(&attributes);
+    pthread_attr_setstacksize(&attributes, size_t(64) << 20);
+    for (auto& handle : handles)
+        pthread_create(&handle, &attributes, run, &shared);
+    for (auto& handle : handles)
+        pthread_join(handle, nullptr);
+    pthread_attr_destroy(&attributes);
+}
