+    bool SaveVulkanPipelineCache(RenderDevice *device) {
+        auto *vulkanDevice = static_cast<VulkanDevice *>(device);
+        if (vulkanDevice == nullptr || vulkanDevice->pipelineCache == VK_NULL_HANDLE || g_pipelineCachePath.empty()) {
+            return false;
+        }
+        size_t size = 0;
+        if (vkGetPipelineCacheData(vulkanDevice->vk, vulkanDevice->pipelineCache, &size, nullptr) != VK_SUCCESS || size == 0) {
+            return false;
+        }
+        std::vector<char> data(size);
+        if (vkGetPipelineCacheData(vulkanDevice->vk, vulkanDevice->pipelineCache, &size, data.data()) != VK_SUCCESS) {
+            return false;
+        }
+        // Written beside it, then moved over it: a crash or a full disk leaves the old file whole.
+        const std::string temporary = g_pipelineCachePath + ".tmp";
+        {
+            std::ofstream file(temporary, std::ios::binary | std::ios::trunc);
+            if (!file.write(data.data(), std::streamsize(size))) {
+                return false;
+            }
+        }
+        std::error_code error;
+        std::filesystem::rename(temporary, g_pipelineCachePath, error);
+        return !error;
+    }
